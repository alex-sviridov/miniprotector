# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
!bin/local.conf

# `make <binary>` always builds to bin/ (ignored above). These cover the two
# other places a same-named binary lands without -o: `go build ./cmd/<name>/...`
# from src/ (module root), and `go build .` run from inside cmd/<name>/ itself.
/src/agent
/src/api-server
/src/brfs
/src/bwfs
/src/catalog
/src/catalogsync
/src/certclient
/src/clientmanager
/src/clientmanager-admin-api
/src/clientmanager-api
/src/issuer
/src/log-gateway
/src/policyclient
/src/policy-server
/src/rwfs
